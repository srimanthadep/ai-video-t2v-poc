# ============================================================
# Environment Configuration Template for T2V POC (Member 5)
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ============================================================

# API Keys (Required only for real API generation, not needed for mock engine)
FAL_KEY=your_fal_api_key_here
WAVESPEED_API_KEY=your_wavespeed_key_here

# Active T2V Provider: "mock" (default, free, fast) or "fal_ai"
T2V_PROVIDER=mock

# Default Model Selection
T2V_MODEL=Wan2.2-T2V-A14B

# Generation Defaults
T2V_DEFAULT_RESOLUTION=832x480
T2V_DEFAULT_FPS=16
T2V_DEFAULT_DURATION=5

# Engine Output & Timeout Settings
T2V_OUTPUT_DIR=outputs
T2V_TIMEOUT_SECONDS=300
T2V_MAX_RETRIES=2
